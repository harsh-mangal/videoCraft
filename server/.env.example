# Local development. Use a real HTTPS origin and NODE_ENV=production on your server.
NODE_ENV=development
HOST=127.0.0.1
PORT=4691
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=videocrafts
PUBLIC_ORIGIN=http://127.0.0.1:4691
# Production: PUBLIC_ORIGIN=https://www.videocraftsindia.com
API_ORIGIN=http://127.0.0.1:4691
# Production: API_ORIGIN=https://api.videocraftsindia.com
# Exact browser origins, separated by commas. Never use a wildcard.
ADMIN_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:4691
# Production: ADMIN_ORIGINS=https://admin.videocraftsindia.com
# Optional one-time Postman setup. Use 32+ random characters, create the first
# admin through POST /api/admin/setup, then remove this value and restart Node.
# ADMIN_SETUP_TOKEN=replace-with-a-random-one-time-secret-at-least-32-characters
# Keep uploads on persistent storage, outside build directories.
# DATA_DIR=/absolute/path/to/private/videocrafts-data
# The API runs without frontend files. Set these only if this Node process also
# serves the built website/admin and the website's generated renderer.
# SITE_DIR=/var/www/videocrafts-client/build
# ADMIN_DIR=/var/www/videocrafts-admin/dist
# RENDERER_DIR=/var/www/api.videocraftsindia.com/site-renderer
# CLIENT_SEO_FILE=/var/www/videocrafts-client/src/config/seo.js
# SEO_RENDERER_FILE=/var/www/videocrafts-client/scripts/seo.mjs
# Storage budget includes retained previous upload versions.
MAX_STORAGE_MB=1024
# Set only behind a trusted reverse proxy; do not expose the backend port publicly.
TRUST_PROXY_HOPS=0
