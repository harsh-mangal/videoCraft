{
  "name": "videocrafts-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "astro dev --host 127.0.0.1",
    "dev": "astro dev --host 127.0.0.1",
    "build": "node ../server/scripts/sync-catalog.mjs && astro build && node scripts/postbuild.mjs && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm --prefix .. run lint:client",
    "check:seo": "node scripts/check-build.mjs",
    "audit:production": "node scripts/audit-production.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/mulish": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "astro": "^7.3.8",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
