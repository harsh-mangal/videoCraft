---
import { managedImageSrcSet, managedImageUrl, resolveImage } from "../utils/images";

const {
  src,
  media = {},
  alt,
  width = 1600,
  sizes = "100vw",
  priority = false,
  class: className,
  ...attributes
} = Astro.props;
const image = resolveImage(src, media);
const displayWidth = Math.min(width, image.width || width);
const displayHeight = image.width && image.height ? Math.round(displayWidth * image.height / image.width) : Math.round(displayWidth * 0.75);
const webp = managedImageSrcSet(image, width, "webp");
const avif = managedImageSrcSet(image, width, "avif");
---
<picture>
  {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
  <img
    {...attributes}
    class={className}
    data-media-id={image.id}
    src={managedImageUrl(image, width)}
    srcset={webp}
    sizes={sizes}
    width={displayWidth}
    height={displayHeight}
    alt={image.alt || alt}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : undefined}
  />
</picture>

