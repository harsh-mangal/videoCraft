---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutPage from "../islands/AboutPage";
import { loadPublishedMedia, mediaForRoute } from "../lib/publishedMedia";
const media = await loadPublishedMedia();
const pageMedia = mediaForRoute(media, "/about");
---
<BaseLayout pathname="/about" media={media}><AboutPage media={pageMedia} client:visible /></BaseLayout>
