{
  "name": "videocrafts-india",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .cache/ssr && node scripts/prerender.mjs && node scripts/check-build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src scripts vite.config.js",
    "check:seo": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
