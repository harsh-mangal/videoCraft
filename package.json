{
  "name": "videocrafts-india",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm --prefix client start",
    "dev": "npm --prefix client run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "build:all": "npm run build && npm --prefix admin run build",
    "preview": "npm --prefix client run preview",
    "test": "npm --prefix client test",
    "test:all": "npm test && npm --prefix admin test && npm --prefix server test",
    "test:watch": "npm --prefix client run test:watch",
    "lint": "eslint client/src client/scripts client/vite.config.js server/src server/scripts server/test admin/src admin/vite.config.js eslint.config.js",
    "lint:client": "eslint client/src client/scripts client/vite.config.js",
    "check:seo": "npm --prefix client run check:seo"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0"
  }
}
